# Gradle / Android build output
.gradle/
build/
app/build/

# Local machine and IDE state
local.properties
.idea/
*.iml

# Native and generated artifacts
.cxx/
.externalNativeBuild/

# Codex/runtime attachments and transient files
.codex-remote-attachments/

# Local APK build output stays ignored, but archived working builds under
# releases/<version>/ are intentionally committed for this private repo.
*.apk
!releases/**/*.apk
